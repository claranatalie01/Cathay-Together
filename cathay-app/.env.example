# The ONE environment file for Cathay Together.
#
# How to use this file:
#   1. Copy it to a new file called .env in this same folder. There is no .env.local and no server/.env.
#   2. Fill in the values you need (the dashboards named below).
#   3. Run `npm run check:backend` to confirm the Supabase values work.
#
# .env is ignored by git, so your values never reach GitHub.
# This file (.env.example) IS committed, so keep it free of real values.
#
# Anything starting with VITE_ is sent to the browser by the build. Everything else stays on the
# server or your laptop (the Python planner and the scripts read it; the React code cannot).
# On Vercel, set the same names in the project's Environment Variables: it does not read this file.

# Which backend the app uses: mock (default, inside this browser) or shared (Supabase).
# Leave it out to keep `npm run dev` on the mock; `npm run dev:shared` sets it for you.
# VITE_DATA_MODE=shared

# ---- Supabase: public values (designed to be public) -------------------------------------------
# The project address, for example https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# The publishable key. It starts with sb_publishable_ (older projects call it the anon key).
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Supabase: SECRET key. Server only -----------------------------------------------------------
# sb_secret_... or service_role. It bypasses every access rule. NEVER prefix it with VITE_, never put it
# in the React code or anywhere in the repository. The Python planner needs it to save plans.
SUPABASE_SECRET_KEY=

# ---- Itinerary planner (server only) -------------------------------------------------------------
POE_API_KEY=
# POE_MODEL=GPT-4o-Mini
TAVILY_API_KEY=
# Geoapify supplies venue and meal-district coordinates for transfer estimates.
GEOAPIFY_API_KEY=
# Optional: Google Places ratings and Poe endpoint and timeout overrides.
GOOGLE_PLACES_API_KEY=
# POE_BASE_URL=https://api.poe.com/v1/
# LLM_TIMEOUT_SECONDS=60

# ---- OAG flight schedules ------------------------------------------------------------------------
# Organiser-provided Flight Info API key. Only scripts/fetch-oag.mjs reads it, on your own machine.
OAG_SUBSCRIPTION_KEY=
