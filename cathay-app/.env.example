# Settings for the shared backend (Supabase).
#
# How to use this file:
#   1. Copy it to a new file called .env.local in this same folder.
#   2. Fill in the two values from the Supabase dashboard (the "API Keys" page).
#   3. Run `npm run check:backend` to confirm they work.
#
# .env.local is ignored by git, so your values never reach GitHub.
# This file (.env.example) IS committed, so keep it free of real values.
#
# Both values below are designed to be public: they end up in the browser.
# The SECRET key (sb_secret_... or service_role) must NEVER go in this file,
# in the React code, or anywhere in the repository.

# Which backend the app uses: mock (default, inside this browser) or shared (Supabase).
# Leave it out to keep `npm run dev` on the mock; `npm run dev:shared` sets it for you.
# VITE_DATA_MODE=shared

# The project address, for example https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The publishable key. It starts with sb_publishable_ (older projects call it the anon key).
VITE_SUPABASE_PUBLISHABLE_KEY=

# OAG flight schedules (organiser-provided Flight Info API key). Only scripts/fetch-oag.mjs reads it,
# on your own machine. Never put it in the React code (anything with VITE_ is public).
OAG_SUBSCRIPTION_KEY=
