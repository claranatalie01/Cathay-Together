{
  "name": "cathay-together-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:shared": "VITE_DATA_MODE=shared vite",
    "dev:api": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "dev:all": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8000 & API=$!; trap 'kill $API 2>/dev/null' EXIT INT TERM; VITE_DATA_MODE=shared vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/algorithms/",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "fetch:oag": "node scripts/fetch-oag.mjs",
    "icons:inventory": "node scripts/icon-inventory.mjs",
    "prebuild": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.6"
  }
}
